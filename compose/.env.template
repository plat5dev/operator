# Image pin for ghcr.io/plat5dev/operator — tags cut from this repo (git tag v*).
OPERATOR_VERSION=v0.1.0

# Optional first operator. Ignored after that email exists. Omit both to skip.
# OPERATOR_BOOTSTRAP_EMAIL=operator@localhost
# OPERATOR_BOOTSTRAP_PASSWORD=

