# Image tag from this repo's v* releases.
OPERATOR_VERSION=

# Operator IdP. Contract: docs/reference/idp.md. Never the customer IdP.
AUTH_ISSUER=
AUTH_JWKS_URI=
# Required. The API audience(s) your IdP puts in aud.
AUTH_AUDIENCES=
# AUTH_OPERATOR_ID_CLAIM=sub
# AUTH_OPERATOR_EMAIL_CLAIM=email

# Plat5 identity's public base URL, as this gateway reaches it. Contract: docs/reference/gateway.md#identity.
IDENTITY_URL=

# Origins whose browser clients may call. Empty = no CORS.
# ALLOWED_ORIGINS=https://console.example.com

# Image default is /routes.yml: Plat5 identity and audit at Plat5's compose addresses, and the
# operator log. Bind-mount a deployment copy and point ROUTES_FILE at it (docs/reference/routes.md).
# ROUTES_FILE=/routes.yml

# Operator audit log. Contract: docs/concepts/audit.md. On unless AUDIT_ENABLED=false.
# AUDIT_ENABLED=true

# The operator plane's Postgres: superuser, audit schema owner (migrations only), writer (runtime).
# Postgres reads these once, when its data directory is empty. URL-safe characters only:
# the audit passwords go into connection URLs.
OPERATOR_POSTGRES_PASSWORD=
AUDIT_OWNER_PASSWORD=
AUDIT_WRITER_PASSWORD=
